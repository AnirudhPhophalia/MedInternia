# ─── RAG Microservice Environment Variables ────────────────────────────────────

# Shared secret validated on every inbound request via the X-Internal-Token
# header. Must match RAG_INTERNAL_SECRET in backend/.env.
# Generate with: openssl rand -hex 32
RAG_INTERNAL_SECRET=CHANGE_THIS_TO_A_SECURE_RANDOM_VALUE

# Comma-separated list of origins allowed to make CORS requests to this service.
# Typically the backend server URL. Do NOT use * in production.
RAG_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
